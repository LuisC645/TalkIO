# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# ─── Frontend (Vite) — públicas, se incluyen en el bundle ─────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy; ambas sirven.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Panel de pruebas en el dashboard (true solo en desarrollo). Requiere el secreto
# DEV_TOOLS_ENABLED=true en las Edge Functions.
VITE_DEV_TOOLS=false
# Correos que ven el panel "Pruebas" (separados por comas). El servidor lo exige además con
# el secreto ADMIN_EMAILS: npx supabase secrets set ADMIN_EMAILS=tu@correo.com
VITE_ADMIN_EMAILS=

# ─── Edge Functions — secretos (`supabase secrets set` en producción).
#     Nunca con prefijo VITE_. ────────────────────────────────────────────────
GEMINI_API_KEY=
# Tiers de modelo (ver supabase/functions/_shared/ai/models.ts).
# Todos en 3.1 Flash-Lite (el más barato disponible; 2.5 Flash-Lite solo funciona en proyectos que ya lo usaban); cambiar aquí sin tocar código.
AI_MODEL_LITE=gemini-3.1-flash-lite
AI_MODEL_STANDARD=gemini-3.1-flash-lite
AI_MODEL_PRO=gemini-3.1-flash-lite
# Opcional: respaldos si el modelo principal está saturado (lista separada por comas).
# Por defecto: gemini-3.5-flash-lite
# AI_MODEL_STANDARD_FALLBACK=
# AI_MODEL_LITE_FALLBACK=
# Correos con Brevo (recomendado sin dominio propio; plan gratis 300/día). Clave: Brevo →
# SMTP & API → API keys. Remitente: un correo verificado en Brevo. Si está definida, se usa Brevo;
# si no, Resend. En producción: npx supabase secrets set BREVO_API_KEY=... BREVO_SENDER=...
BREVO_API_KEY=
BREVO_SENDER=talkioapp.dev@gmail.com
# Correos (Resend, https://resend.com/api-keys). Sin dominio verificado, Resend solo envía desde
# onboarding@resend.dev y solo al correo de tu cuenta de Resend.
RESEND_API_KEY=
# Remitente. Sin dominio verificado se usa onboarding@resend.dev, que solo entrega al correo de
# la cuenta de Resend; con dominio: RESEND_FROM="TalkIO <hola@tudominio.com>"
# RESEND_FROM=
# URL pública de la app (para los botones de los correos), p. ej. https://talkio.app
# APP_URL=
# Firma de los enlaces de baja: npx supabase secrets set EMAIL_UNSUBSCRIBE_SECRET=<aleatorio>

# Interruptor de emergencia: true = no se llama a Gemini y cada función usa su alternativa sin IA
# (lección de repaso, examen semanal con tus ejercicios, revisión básica de escritura, test por preguntas).
# En producción: npx supabase secrets set AI_DISABLED=true | false
AI_DISABLED=false

# ─── Scripts locales (scripts/seed-user.ts) — solo en tu máquina ───────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Email de la cuenta (ya registrada en Auth) a la que se asigna el seed
SEED_USER_EMAIL=
